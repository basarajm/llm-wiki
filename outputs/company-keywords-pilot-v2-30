function render(rows) {
  const tbody = document.getElementById('kwBody');
  tbody.innerHTML = '';
  rows.forEach(([name, biz, win, news]) => {
    const tr = document.createElement('tr');
    tr.dataset.search = (name + ' ' + biz.join(' ') + ' ' + news.join(' ')).toLowerCase();
    const bizHtml = biz.map(k => `<span class="tag">${k}</span>`).join('');
    const newsHtml = news.length ? news.map(k => `<span class="tag news">${k}(뉴스)</span>`).join('') : '<span style="color:var(--muted)">-</span>';
    tr.innerHTML = `<td class="company">${name}</td><td>${bizHtml}</td><td class="window">${win}</td><td>${newsHtml}</td>`;
    tbody.appendChild(tr);
  });
}
render(DATA);

document.getElementById('search').addEventListener('input', (e) => {
  const q = e.target.value.trim().toLowerCase();
  document.querySelectorAll('#kwBody tr').forEach(tr => {
    tr.classList.toggle('hidden', q && !tr.dataset.search.includes(q));
  });
});
